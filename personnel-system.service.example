[Unit]
Description=Personnel System (offline WSGI service)
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/personnel-system
ExecStart=/opt/personnel-system/run_production.sh
Restart=on-failure
RestartSec=5
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=WAITRESS_THREADS=8
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
